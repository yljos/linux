{
  "$schema": "schema.json",
  "log": {"level": "error", "timestamp": true},
  "http_clients": [{"tag": "proxy-client", "detour": "D"}],
  "dns": {
    "strategy": "ipv4_only",
    "servers": [
      {"type": "udp", "tag": "dns_resolver", "detour": "D", "server": "223.5.5.5", "server_port": 53},
      {"type": "https", "tag": "dns_proxy", "detour": "M", "domain_resolver": "dns_resolver", "server": "cloudflare-dns.com", "server_port": 443},
      {"type": "https", "tag": "dns_google", "detour": "Google", "domain_resolver": "dns_resolver", "server": "dns.google", "server_port": 443},
      {"type": "https", "tag": "dns_microsoft", "detour": "Microsoft", "domain_resolver": "dns_resolver", "server": "cloudflare-dns.com", "server_port": 443},
      {"type": "https", "tag": "dns_direct", "detour": "D", "domain_resolver": "dns_resolver", "server": "dns.alidns.com", "server_port": 443}
    ],
    "rules": [
      {"domain": "ntp.aliyun.com", "server": "dns_direct"},
      {"domain_keyword": ["msftconnecttest.com", "msftncsi.com"], "server": "dns_microsoft"},
      {"domain_keyword": "googleapis", "server": "dns_google"},
      {"rule_set": "googlefcm-site", "server": "dns_google"},
      {"rule_set": "ad-site", "action": "reject"},
      {"rule_set": "cn-site", "server": "dns_direct"},
      {"query_type": ["AAAA"], "action": "reject", "method": "default", "no_drop": true}
    ],
    "final": "dns_proxy"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 12138
    }
  ],
  "outbounds": [
    {"type": "direct", "tag": "D", "domain_resolver": "dns_direct"},
    {"type": "block", "tag": "R"},
    {"type": "selector", "tag": "Default", "outbounds": ["M", "R", "D"], "default": "R"},
    {"type": "selector", "tag": "M", "outbounds": ["SG", "JP", "US", "HK"], "default": "JP"},
    {"type": "selector", "tag": "Youtube", "outbounds": ["JP", "US", "SG", "HK"], "default": "US"},
    {"type": "selector", "tag": "Google", "outbounds": ["JP", "US", "SG", "GCP-outbound"], "default": "GCP-outbound"},
    {"type": "selector", "tag": "OpenAi", "outbounds": ["JP", "US", "SG", "HK"], "default": "JP"},
    {"type": "selector", "tag": "Relay", "outbounds": ["JP", "US", "SG", "HK"], "default": "JP"},
    {"type": "selector", "tag": "Steam", "outbounds": ["D", "JP", "US", "SG", "HK"], "default": "HK"},
    {"type": "selector", "tag": "Telegram", "outbounds": ["JP", "US", "SG", "HK"], "default": "JP"},
    {"type": "selector", "tag": "PikPak", "outbounds": ["SG", "JP", "US", "HK"], "default": "SG"},
    {"type": "selector", "tag": "GitHub", "outbounds": ["JP", "US", "SG", "HK"], "default": "JP"},
    {"type": "selector", "tag": "Microsoft", "outbounds": ["JP", "US", "SG", "HK", "D"], "default": "JP"},
    {"type": "selector", "tag": "Twitter", "outbounds": ["US"], "default": "US"},
    {"type": "urltest", "tag": "HK", "outbounds": ["{all}"], "url": "https://www.gstatic.com/generate_204", "interval": "30s", "tolerance": 300, "filter": [{"action": "match", "regex": ["(?i)^.*(HK|Hong Kong).*$"]}]},
    {"type": "urltest", "tag": "SG", "outbounds": ["{all}"], "url": "https://www.gstatic.com/generate_204", "interval": "30s", "tolerance": 300, "filter": [{"action": "match", "regex": ["(?i)^.*(SG|Singapore).*$"]}]},
    {"type": "urltest", "tag": "JP", "outbounds": ["{all}"], "url": "https://www.gstatic.com/generate_204", "interval": "30s", "tolerance": 300, "filter": [{"action": "match", "regex": ["(?i)^.*(JP|Japan).*$"]}]},
    {"type": "urltest", "tag": "US", "outbounds": ["{all}"], "url": "https://www.gstatic.com/generate_204", "interval": "30s", "tolerance": 300, "filter": [{"action": "match", "regex": ["(?i)^.*(US|United States).*$"]}]}
  ],
  "route": {
    "rules": [
      {"ip_cidr": "223.5.5.5", "outbound": "D"},
      {"type": "logical", "mode": "and", "rules": [{"network": "udp"}, {"port": 443}], "action": "reject", "no_drop": true},
      {"action": "sniff", "timeout": "300ms"},
      {"rule_set": "ad-site", "action": "reject"},
      {"rule_set": "ad-ip", "action": "reject"},
      {"rule_set": "huawei-site", "action": "reject"},
      {"rule_set": "huawei-ip", "action": "reject"},
      {"domain": ["cdn.jsdmirror.com", "ntp.aliyun.com"], "outbound": "D"},
      {"domain_keyword": ["msftconnecttest.com", "msftncsi.com"], "outbound": "Microsoft"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"domain_keyword": "googleapis"}], "outbound": "Youtube"},
      {"domain_keyword": "googleapis", "outbound": "Google"},
      {"rule_set": "direct-site", "outbound": "D"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.21/32"}, {"rule_set": "cloudflare-site"}], "outbound": "D"},
      {"rule_set": "cloudflare-site", "outbound": "M"},
      {"rule_set": "proxy-site", "outbound": "M"},
      {"rule_set": "openai-site", "outbound": "OpenAi"},
      {"rule_set": "pikpak-site", "outbound": "PikPak"},
      {"rule_set": "javdb-site", "outbound": "M"},
      {"rule_set": "tmdb-site", "outbound": "M"},
      {"rule_set": "speedtest-site", "outbound": "M"},
      {"rule_set": "codeberg-site", "outbound": "GitHub"},
      {"rule_set": "fdroid-site", "outbound": "M"},
      {"rule_set": "adguard-site", "outbound": "M"},
      {"rule_set": "docker-site", "outbound": "M"},
      {"rule_set": "archlinux-site", "outbound": "M"},
      {"rule_set": "steam-site", "outbound": "Steam"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"rule_set": "youtube-site"}], "outbound": "Youtube"},
      {"rule_set": "youtube-site", "outbound": "Google"},
      {"rule_set": "tiktok-site", "outbound": "JP"},
      {"rule_set": "github-site", "outbound": "GitHub"},
      {"rule_set": "mozilla-site", "outbound": "M"},
      {"rule_set": "googlefcm-site", "outbound": "D"},
      {"rule_set": "telegram-site", "outbound": "Telegram"},
      {"rule_set": "twitter-site", "outbound": "Twitter"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"rule_set": "google-site"}], "outbound": "Youtube"},
      {"rule_set": "google-site", "outbound": "Google"},
      {"rule_set": "tencent-site", "outbound": "D"},
      {"rule_set": "microsoft-site", "outbound": "Microsoft"},
      {"rule_set": "gfw-site", "outbound": "M"},
      {"rule_set": "cn-site", "outbound": "D"},
      {"action": "resolve", "server": "dns_proxy"},
      {"rule_set": "direct-ip", "outbound": "D"},
      {"rule_set": "wechat-ip", "outbound": "D"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.21/32"}, {"rule_set": "cloudflare-ip"}], "outbound": "D"},
      {"rule_set": "cloudflare-ip", "outbound": "M"},
      {"rule_set": "pikpak-ip", "outbound": "PikPak"},
      {"rule_set": "twitter-ip", "outbound": "Twitter"},
      {"rule_set": "telegram-ip", "outbound": "Telegram"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"rule_set": "google-ip"}], "outbound": "Youtube"},
      {"rule_set": "google-ip", "outbound": "Google"},
      {"rule_set": "cn-ip", "outbound": "D"}
    ],
    "rule_set": [
      {
        "tag": ["ad-site", "adguard-site", "archlinux-site", "cn-site", "codeberg-site", "cloudflare-site", "docker-site", "fdroid-site", "gfw-site", "github-site", "google-site", "googlefcm-site", "javdb-site", "microsoft-site", "mozilla-site", "openai-site", "speedtest-site", "steam-site", "tencent-site", "telegram-site", "tiktok-site", "tmdb-site", "twitter-site", "youtube-site", "direct-site", "huawei-site", "pikpak-site", "proxy-site", "ad-ip", "cn-ip", "cloudflare-ip", "google-ip", "telegram-ip", "twitter-ip", "direct-ip", "huawei-ip", "pikpak-ip", "wechat-ip"],
        "type": "remote",
        "url": "https://rules.346211.xyz/{tag}.srs",
        "update_interval": "12h0m0s"
      }
    ],
    "final": "Default",
    "default_domain_resolver": {"server": "dns_direct", "rewrite_ttl": 10}
  },
  "experimental": {
    "cache_file": {"enabled": true, "path": "cache.db", "store_dns": true},
    "clash_api": {"external_controller": "127.0.0.1:9090", "external_ui": "ui", "external_ui_download_url": "https://www.346211.xyz/dist.zip", "external_ui_download_detour": "D", "default_mode": "rule"}
  }
}

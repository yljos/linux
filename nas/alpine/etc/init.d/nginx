#!/sbin/openrc-run

# Service description
description="Nginx Container (Podman)"

# Service dependencies
depend() {
    need net
    after firewall
}

# Daemon configuration
name="nginx"
command="/usr/bin/podman"
command_args="run \
    --replace \
    --rm \
    --name=${name} \
    --network=host \
    -v /data/appdata/nginx/conf.d:/etc/nginx/conf.d:Z \
    -v /data/appdata/nginx/nginx.conf:/etc/nginx/nginx.conf:Z \
    -v /data/www:/usr/share/nginx/html:ro,z \
    docker.io/nginx:latest"

# Run in background via start-stop-daemon
command_background="true"
pidfile="/run/${RC_SVCNAME}.pid"

# Graceful container shutdown
stop() {
    ebegin "Stopping ${RC_SVCNAME}"
    /usr/bin/podman stop -t 10 "${name}" >/dev/null 2>&1
    eend $?
}
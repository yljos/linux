# Define MAC allowlist
set clash_mac_allowlist {
    type ether_addr
    flags dynamic
}

# TPROXY chain for clash
chain prerouting_clash {
    type filter hook prerouting priority mangle; policy accept;
    
    # Bypass local LAN and OpenNDS portal
    ip daddr { 127.0.0.0/8, 10.0.0.0/24 } return
    tcp dport 2050 return
    
    # Bypass unauthorized MACs
    ether saddr != @clash_mac_allowlist return
    
    # TPROXY to clash (assume port 7892)
    meta l4proto { tcp, udp } meta mark set 1 tproxy to :7893 accept
}